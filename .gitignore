# ═══════════════════════════════════════════════════════════
# FUT Minna Staff Dashboard - .gitignore
# ═══════════════════════════════════════════════════════════

# ── Environment variables: never commit real secrets ──────
.env
.env.*
!.env.example

# ── Dependencies ────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build & Output ──────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ── Offline-mode database files ─────────────────────────
.localdb/

# ── Logs ────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── OS Files ────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor Files ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Miscellaneous ───────────────────────────────────────
*.tgz
*.tar.gz
.cache/
.parcel-cache/
