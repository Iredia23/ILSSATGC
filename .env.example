# Copy this file to .env.local and fill in your own values.
# Never commit .env.local: it holds your real secrets.

# Core secrets
DB_URL=mongodb+srv://<user>:<password>@<cluster-address>/<database-name>
JWT_SECRET=<a long random string>
GOOGLE_API_KEY=<your Gemini API key>

# Demo account passwords (used when seeding demo users into a database)
SEED_ADMIN_PASSWORD=<password for the demo Admin account>
SEED_USER_PASSWORD=<password for every other demo account>

# Auth/session settings
JWT_EXPIRE=12h
JWT_REFRESH_EXPIRE=30d

# Security and limits
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_COURSES_PER_LECTURER=4

# Runtime and networking
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Frontend API base URL (Vite)
VITE_API_URL=http://localhost:5000/api
